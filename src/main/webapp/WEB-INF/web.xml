<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Sistema de Gestión de Inventario – Restaurant</display-name>

    <!-- ════════════════════════════════════════════════════════
         Página de bienvenida: redirige al servlet de login
    ════════════════════════════════════════════════════════ -->
    <welcome-file-list>
        <welcome-file>login</welcome-file>
    </welcome-file-list>

    <!-- ════════════════════════════════════════════════════════
         Configuración de sesión
         (30 minutos de tiempo de expiración por inactividad)
    ════════════════════════════════════════════════════════ -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- Activar 'secure' solo en producción con HTTPS -->
            <!-- <secure>true</secure> -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ════════════════════════════════════════════════════════
         Páginas de error personalizadas
    ════════════════════════════════════════════════════════ -->
    <error-page>
        <error-code>404</error-code>
        <location>/login</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/login</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/login</location>
    </error-page>

</web-app>
